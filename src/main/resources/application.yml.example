# Core Plugin Base - Configuration Example
# Copy this file to application.yml and adjust as needed

# Storage type: DATABASE or FILE
storageType: DATABASE

# Database configuration (only used if storageType is DATABASE)
database:
  host: localhost
  port: 5432
  name: hyhavenworld
  user: postgres
  pass: your_password
  maximumPoolSize: 10

# File configuration (only used if storageType is FILE)
file:
  path: data/permissions.yml

# Cache configuration (optional, disabled by default)
caching:
  enabled: true           # Enable/disable caching (default: false)
  ttl: 300                # Time to live in seconds (default: 300 = 5 minutes)
  maxSize: 1000           # Maximum number of entries (default: 1000)

# Example configurations:

# For production with database and caching:
# storageType: DATABASE
# database:
#   host: your-db-server.com
#   port: 5432
#   name: production_db
#   user: app_user
#   pass: secure_password
#   maximumPoolSize: 20
# caching:
#   enabled: true
#   ttl: 600              # 10 minutes
#   maxSize: 5000

# For development with file storage and no caching:
# storageType: FILE
# file:
#   path: dev-data/permissions.yml
# caching:
#   enabled: false

# For testing with file storage and aggressive caching:
# storageType: FILE
# file:
#   path: test-data/permissions.yml
# caching:
#   enabled: true
#   ttl: 60               # 1 minute
#   maxSize: 100